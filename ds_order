include <iostream>
#include <stack>
using namespace std;

int main() {
    stack<int> cancelledOrders;
    int orderNumber;

    cout << "Enter 5 cancelled order numbers:\n";

    // Store 5 order numbers in the stack
    for (int i = 0; i < 5; i++) {
        cin >> orderNumber;
        cancelledOrders.push(orderNumber);
    }

    cout << "\nCancelled orders (most recent first):\n";

    // Display orders from most recent to oldest
    while (!cancelledOrders.empty()) {
        cout << cancelledOrders.top() << endl;
        cancelledOrders.pop();
    }

    return 0;
}
